{
  "name": "@sandalez/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "user:add": "dotenv -e ../../.env -- tsx src/cli/user-add.ts",
    "typecheck": "tsc --noEmit",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "dotenv-cli": "^8.0.0"
  }
}