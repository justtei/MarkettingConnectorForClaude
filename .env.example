# ---------------------------------------------------------------- Meta (see docs/meta-setup.md)
# System user token: ads_management, ads_read, business_management, pages_show_list,
# pages_read_engagement, pages_manage_ads (+ catalog_management for catalog ads)
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
# The ONLY ad account this tool may touch (act_ + digits). Any other ID is refused.
META_AD_ACCOUNT_ID=act_0000000000
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_PIXEL_ID=
# Needed for catalogs / owned pages (Business Manager ID)
META_BUSINESS_ID=
# WhatsApp number linked to the Page, digits with country code
WHATSAPP_PHONE_NUMBER=923499066816
# Pinned API version — review quarterly
META_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Optional: Conversions API test code (Events Manager > Test events)
META_CAPI_TEST_EVENT_CODE=

# ---------------------------------------------------------------- Safety caps (editable later in Settings)
MAX_DAILY_BUDGET_PKR=2000
MAX_BUDGET_INCREASE_PCT=30

# ---------------------------------------------------------------- Database / Redis
DATABASE_URL=postgresql://sandalez:sandalez@localhost:5432/sandalez?schema=public

# ---------------------------------------------------------------- MCP server (apps/mcp)
MCP_PORT=3001
# Long random secret; Claude sends it as "Authorization: Bearer <secret>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_BEARER_TOKEN=
# Optional comma-separated IP allowlist: exact IPs and/or CIDR ranges. Empty = allow all (secret still required).
# claude.ai connects from 160.79.104.0/21 (Anthropic); add your own IP too if you use Claude Code from your PC.
MCP_IP_ALLOWLIST=
# Optional: path secret so the connector URL itself is unguessable (https://host/mcp/<path secret>)
MCP_PATH_SECRET=

# ---------------------------------------------------------------- REST API (apps/api)
API_PORT=3002
# Shared secret between the dashboard server and the API (never sent to browsers)
API_INTERNAL_SECRET=
# First owner login, created on API start only when there are no users yet
OWNER_EMAIL=
OWNER_PASSWORD=
# WhatsApp Cloud API webhook (optional)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Shopify orders/create webhook -> Conversions API (optional)
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Dashboard (apps/web)
WEB_PORT=3000
API_URL=http://localhost:3002
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------- Worker (apps/worker)
SYNC_CRON=0 */3 * * *
ALERTS_CRON=15 */3 * * *
WEEKLY_REPORT_CRON=0 9 * * 1
TOKEN_CHECK_CRON=0 8 * * *
SYNC_DAYS=7
RUN_SYNC_ON_START=true

# ---------------------------------------------------------------- Email (optional, for alerts + weekly report)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_EMAIL_TO=

LOG_LEVEL=info

# ---------------------------------------------------------------- Docker Compose (production)
POSTGRES_PASSWORD=
# Dashboard domain and MCP domain (both pointed at the VPS)
DOMAIN=ads.example.com
MCP_DOMAIN=mcp.example.com
# Trust X-Forwarded-For from Caddy / Cloudflare for the MCP IP allowlist
TRUST_PROXY=true

# ---------------------------------------------------------------- Laptop / home PC (docker-compose.local.yml, docs/local-laptop.md)
# Cloudflare Tunnel token for permanent https addresses without a static IP (--profile tunnel). Optional.
CLOUDFLARE_TUNNEL_TOKEN=
# Address you open the dashboard at; set to https://ads.<your domain> when using the tunnel. Empty = http://localhost:3000
DASHBOARD_URL=
