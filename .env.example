# =====================================================================================================
#  Sandalez Ads Tool: example settings file
# =====================================================================================================
#
#  DON'T copy this file by hand. Run one of these; it creates the real file from this one and fills
#  every [AUTO] value with a strong random secret:
#
#    Laptop / home PC:   pnpm setup:env --local --owner-email you@example.com
#                        -> writes .env (DOMAIN=localhost:3000, MCP_DOMAIN=localhost:3001)
#    VPS / server:       pnpm setup:env --out .env --owner-email you@example.com \
#                          --domain ads.yourdomain.com --mcp-domain mcp.yourdomain.com
#
#  Then open .env and fill every [REQUIRED] value (all Meta values: docs/meta-setup.md), and check it:
#    pnpm setup:check --env .env            (add --production on a VPS)
#
#  The tags on each setting:
#    [REQUIRED]  you must enter it; only you can get it (from Meta Business Manager etc.)
#    [AUTO]      generated by `pnpm setup:env`; leave it as generated
#    [OPTIONAL]  leave empty to turn the feature off
#    [DEFAULT]   the value shown is fine; change only if you need to
#
#  Keep the real .env private: never commit it, email it or paste it into a chat. It holds the Meta
#  token and every password. It's already in .gitignore.
#
# -----------------------------------------------------------------------------------------------------
#  WHAT THE MACHINE NEEDS
# -----------------------------------------------------------------------------------------------------
#
#  Laptop / home PC (Windows 10/11, macOS 13+ or Linux), see docs/local-laptop.md:
#    - 8 GB RAM or more (the stack uses about 2-3 GB); 10 GB free disk
#    - Docker Desktop              https://www.docker.com/products/docker-desktop
#                                  (Windows: WSL 2 backend; give it at least 4 GB in Settings > Resources)
#    - Git                         https://git-scm.com
#    - Node.js 22 LTS              https://nodejs.org          (only to run the setup scripts)
#    - pnpm 10                     npm install -g pnpm@10
#    - Claude Code (to use it)     npm install -g @anthropic-ai/claude-code
#    - Internet. A static IP is NOT needed. Ports 3000, 3001 and 3002 must be free.
#    - Optional, for claude.ai / other laptops: a free Cloudflare account (+ a domain on Cloudflare
#      for a permanent address). Nothing to install; the tunnel runs in Docker.
#
#  VPS / server, see docs/deploy.md:
#    - Ubuntu 22.04/24.04 (or any Linux with Docker), 2 vCPU, 2-4 GB RAM, 20 GB disk
#    - Docker Engine + Compose plugin   curl -fsSL https://get.docker.com | sh
#    - Git, Node.js 22, pnpm 10 (for the setup scripts)
#    - Ports 80 and 443 open; two DNS A records (DOMAIN and MCP_DOMAIN) pointing at the server
#    - Shared cPanel hosting can't run it; a cPanel VPS with root access can
#
#  Everything else (PostgreSQL 17, Node runtime, Caddy, cloudflared) runs inside Docker, so there's
#  nothing more to install.
# =====================================================================================================


# ---------------------------------------------------------------- Meta (see docs/meta-setup.md)
# [REQUIRED] System user access token, from Business Settings > Users > System users > Generate new token.
# Choose "Never" expire, and tick: ads_management, ads_read, business_management, pages_show_list,
# pages_read_engagement, pages_manage_ads (+ catalog_management for catalog ads). Starts with EAA...
META_ACCESS_TOKEN=
# [REQUIRED] App ID and App secret, from developers.facebook.com > your app > App settings > Basic.
# The secret signs every call (appsecret_proof).
META_APP_ID=
META_APP_SECRET=
# [REQUIRED] The ONLY ad account this tool may touch: act_ + the number after act= in the Ads Manager URL. Any other ID is refused.
META_AD_ACCOUNT_ID=act_0000000000
# [REQUIRED] Facebook Page ID (Page > About > Page transparency, or Business Settings > Pages)
META_PAGE_ID=
# [REQUIRED] Instagram account ID linked to the Page; 17841... (setup:check or the list_instagram_accounts tool shows it once the token works)
META_INSTAGRAM_USER_ID=
# [REQUIRED] Meta pixel / dataset ID (Events Manager > Data sources)
META_PIXEL_ID=
# [REQUIRED] Business Manager ID (Business Settings > Business info); needed for catalogs and owned Pages
META_BUSINESS_ID=
# [REQUIRED] WhatsApp number linked to the Page: digits with the country code, no + or spaces (0300 1234567 -> 923001234567)
WHATSAPP_PHONE_NUMBER=923499066816
# [DEFAULT] Pinned Meta API version; review quarterly (docs/meta-setup.md)
META_API_VERSION=v26.0
# [DEFAULT] Leave as is. (Tests and the demo point this at the Meta mock.)
META_GRAPH_BASE_URL=https://graph.facebook.com
# [OPTIONAL] Conversions API test code (Events Manager > Test events), only while testing the Shopify webhook
META_CAPI_TEST_EVENT_CODE=

# ---------------------------------------------------------------- Safety caps (the owner can change them later in Settings)
# [DEFAULT] Highest daily budget per ad set, in PKR
MAX_DAILY_BUDGET_PKR=2000
# [DEFAULT] Largest budget increase allowed in one change, in percent
MAX_BUDGET_INCREASE_PCT=30

# ---------------------------------------------------------------- Database
# [AUTO] Docker Compose sets the real address itself (postgres:5432 with POSTGRES_PASSWORD below).
# Only matters when running the apps without Docker (development).
DATABASE_URL=postgresql://sandalez:sandalez@localhost:5432/sandalez?schema=public

# ---------------------------------------------------------------- MCP server (what Claude connects to)
# [DEFAULT]
MCP_PORT=3001
# [AUTO] Claude sends it as "Authorization: Bearer <token>". Used in `claude mcp add ... --header`
# and in claude.ai's "Request headers". Treat it like a password.
MCP_BEARER_TOKEN=
# [OPTIONAL] Only let these IPs call the MCP server: comma-separated IPs and/or CIDR ranges. Empty = anyone
# with the secret. For claude.ai only: 160.79.104.0/21 (Anthropic's servers). Leave empty if Claude Code
# connects from laptops whose IP changes.
MCP_IP_ALLOWLIST=
# [AUTO] Secret path for clients that only take a URL (claude.ai without request headers):
# https://<MCP_DOMAIN>/mcp/<MCP_PATH_SECRET>. Treat it like a password.
MCP_PATH_SECRET=

# ---------------------------------------------------------------- REST API (used by the dashboard)
# [DEFAULT]
API_PORT=3002
# [AUTO] Shared secret between the dashboard and the API (never sent to browsers)
API_INTERNAL_SECRET=
# [REQUIRED] First owner login for the dashboard, created on the first start (setup:env fills it from
# --owner-email). Add more users later in Settings or with `pnpm user:add`.
OWNER_EMAIL=
# [AUTO] That owner's password (16 characters, generated). Read it here to sign in the first time.
OWNER_PASSWORD=
# [AUTO] WhatsApp Cloud API webhook verify token, typed into Meta's webhook settings (optional feature)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# [OPTIONAL] Shopify > Settings > Notifications > Webhooks signing secret (orders/create -> Conversions API)
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Dashboard
# [DEFAULT]
WEB_PORT=3000
# [DEFAULT] Docker Compose sets this itself.
API_URL=http://localhost:3002
# [AUTO] Signs dashboard login sessions
AUTH_SECRET=
# [DEFAULT] Docker Compose sets this from DOMAIN (VPS) or DASHBOARD_URL (laptop).
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------- Worker (scheduled jobs, Asia/Karachi time)
# [DEFAULT] Cron schedules: sync from Meta every 3 h, alerts 15 min later, Monday 09:00 report, daily 08:00 token check
SYNC_CRON=0 */3 * * *
ALERTS_CRON=15 */3 * * *
WEEKLY_REPORT_CRON=0 9 * * 1
TOKEN_CHECK_CRON=0 8 * * *
# [DEFAULT] Days of stats each sync refreshes
SYNC_DAYS=7
# [DEFAULT] Sync once whenever the stack starts (catches up after the laptop was off)
RUN_SYNC_ON_START=true

# ---------------------------------------------------------------- Email (optional: alert emails + Monday report)
# [OPTIONAL] Any SMTP server. Gmail: host smtp.gmail.com, port 587, user = your Gmail, pass = an App password
# (Google Account > Security > 2-Step Verification > App passwords). Empty = alerts only in the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# [OPTIONAL] Sender, e.g. Sandalez Ads <you@gmail.com>
SMTP_FROM=
# [AUTO] Who receives the reports (setup:env uses --owner-email; separate several with commas)
REPORT_EMAIL_TO=
# (Port 465 uses TLS automatically; for other ports, add SMTP_SECURE=true to force TLS.)

# [DEFAULT] info, or debug when troubleshooting
LOG_LEVEL=info

# ---------------------------------------------------------------- Docker Compose
# [AUTO] Database password
POSTGRES_PASSWORD=
# [REQUIRED on a VPS] Dashboard domain and MCP domain (two DNS A records pointing at the server).
# setup:env --local sets localhost:3000 / localhost:3001 on a laptop; with a Cloudflare Tunnel, use your tunnel hostnames.
DOMAIN=ads.example.com
MCP_DOMAIN=mcp.example.com
# [DEFAULT] Trust the caller IP from Caddy / Cloudflare (needed by MCP_IP_ALLOWLIST)
TRUST_PROXY=true

# ---------------------------------------------------------------- Laptop / home PC (docker-compose.local.yml, docs/local-laptop.md)
# [OPTIONAL] Cloudflare Tunnel token (the eyJ... string from Zero Trust > Networks > Tunnels) for permanent
# https addresses without a static IP. Also set COMPOSE_PROFILES=tunnel (at the end of .env).
CLOUDFLARE_TUNNEL_TOKEN=
# [OPTIONAL] Address you open the dashboard at; set to https://ads.<your domain> when using the tunnel.
# Empty = http://localhost:3000
DASHBOARD_URL=
# `setup:env --local` adds these three at the end of .env so plain `docker compose` uses the laptop setup:
#   COMPOSE_PATH_SEPARATOR=,
#   COMPOSE_FILE=docker-compose.yml,docker-compose.local.yml
#   COMPOSE_PROFILES=            (empty, quick-tunnel or tunnel)

# ---------------------------------------------------------------- Advanced (rarely needed; remove the # to change)
# Time zone for schedules and reports
# DEFAULT_TIMEZONE=Asia/Karachi
# Retries on temporary Meta errors, and the timeout per Meta call
# META_MAX_RETRIES=3
# META_TIMEOUT_MS=60000
# How long to wait for an uploaded video to be processed
# META_VIDEO_READY_TIMEOUT_MS=180000
